# Publish only the current website and its runtime assets.
# Local research, original attachments, old concepts and QA stay local.
*
!*/
!/.gitignore
!/.nojekyll
!/index.html
!/styles.css
!/script.js
!/media.js
!/.github/README.md
!/assets/fonts/golos-text-variable.woff2
!/assets/fonts/GOLOS-OFL.txt
!/assets/fonts/prata-regular.woff2
!/assets/fonts/PRATA-OFL.txt
!/assets/brand/pavel-rubtsov-monogram.png
!/images/pavel/dark-portrait.png
!/images/pavel/studio-portrait-enhanced.png
!/images/properties/sadovaya-samotechnaya.jpg
!/images/properties/sadovaya-samotechnaya-2.jpg
!/images/media/moscow24-pavel-luxury.jpg
!/images/media/moscow24-small-apartments.jpg
# Reviewed runtime for the client approval preview.
!/favicon.svg
!/robots.txt
!/sitemap.xml
!/images/pavel/portrait-03.webp
!/images/pavel/portrait-03.jpg
!/images/pavel/portrait-06.webp
!/assets/brand/favicon-monogram.png
# Backups contain their own ignore files: prune them explicitly.
/backups/
/content/
/scripts/
/server/
/api/
/qa/
/output/
/images/pavel/originals/
**/.env
**/.env.*
